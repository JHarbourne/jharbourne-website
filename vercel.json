{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/tollesbury-gallery-proposal(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/hbn/static/:path*", "destination": "https://eu-assets.i.posthog.com/static/:path*" },
    { "source": "/hbn/array/:path*", "destination": "https://eu-assets.i.posthog.com/array/:path*" },
    { "source": "/hbn/i/v0/e/", "destination": "https://eu.i.posthog.com/i/v0/e/" },
    { "source": "/hbn/e/", "destination": "https://eu.i.posthog.com/e/" },
    { "source": "/hbn/:path*", "destination": "https://eu.i.posthog.com/:path*" }
  ]
}
